        //{"highlight":{"radius":0.0075, "col":"#FF00005f"}}
        {"beamSpring":3775635.000000,"beamDamp":269.611176},
        ["rs1l", "rx1l"],
        ["rs1l", "rx2l"],
        ["rs1r", "rx1r"],
