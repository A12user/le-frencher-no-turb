        ["rh2l","rw1l"{"name":"axle_RL"}],
        ["rh3l","rw1l"],
        ["rh4l","rw1l"],
        ["rh5l","rw1l"],
        ["rh1l","rw1ll"],
        ["rh2l","rw1ll"],
        ["rh3l","rw1ll"],
        ["rh4l","rw1ll"],
        ["rh5l","rw1ll"],
        {"optional":false},
        {"breakGroup":""},

        //wheel damping help
        {"beamSpring":0,"beamDamp":363.718079},
        //{"beamSpring":5456499.000000,"beamDamp":181.859039},
        //breakGroup: when one beam breaks, all beams in the group are forced to break
        {"breakGroup":"wheel_RR"},
        {"optional":true},
        ["a18","rw1r",{"dampCutoffHz":500}],
        ["a18","rw1rr",{"dampCutoffHz":500}],
        {"breakGroup":"wheel_RL"},
        ["a17","rw1l",{"dampCutoffHz":500}],
        ["a17","rw1ll",{"dampCutoffHz":500}],
        {"optional":false},
        {"breakGroup":""},

        //lower wishbone
        {"beamSpring":4495872.500000,"beamDamp":1198.739502},
        //dampCutoffHz raises the damping stability by filtering out high frequencies
        ["rh3r", "rx2r",{"dampCutoffHz":500}],
        ["rh4r", "rx1r",{"dampCutoffHz":500,"beamPrecompression":"$=(0.005000/175+1)*$toe_R"}],
        ["rh3r", "rx1r",{"dampCutoffHz":500}],
        ["rh4r", "rx2r",{"dampCutoffHz":500,"beamPrecompression":"$=(0.005000/175+1)*$toe_R"}],

        ["rh3l", "rx2l",{"dampCutoffHz":500}],
        ["rh4l", "rx1l",{"dampCutoffHz":500,"beamPrecompression":"$=(0.005000/175+1)*$toe_R"}],
        ["rh3l", "rx1l",{"dampCutoffHz":500}],
        ["rh4l", "rx2l",{"dampCutoffHz":500,"beamPrecompression":"$=(0.005000/175+1)*$toe_R"}],

        //subframe
        {"beamSpring":8089414.000000,"beamDamp":269.611176},
        ["rx1l", "rx2l"],
        ["rx1r", "rx2r"],
        ["rx1l", "rx1r"],
        ["rx2l", "rx2r"],
        ["rx1l", "rx2r"],
        ["rx2l", "rx1r"],
		//swaybar Supports
		
		{"highlight":{"radius":0.01, "col":"#7c1919d9"}},
		
		["rx1r", "rsb1r"],
		["rx2r", "rsb1r"],		
		["rco1r", "rsb1r"],
		
		
		["rx1l", "rsb1l"],
