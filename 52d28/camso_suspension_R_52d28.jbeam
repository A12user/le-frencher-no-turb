        ["rh2l", "strut_RL", true, true, 0.0, 11639706.000000, "FLT_MAX", "FLT_MAX"]
    ],
    "beams": [
        ["id1:", "id2:"],
        //macpherson strut suspension
        {"beamPrecompression":1, "beamType":"|NORMAL"},
        //hub
        {"beamSpring":"$=5092780.500000*($hubStiffnessMult_R or 1)","beamDamp":"$=181.859039*($hubStiffnessMult_R or 1)"},
        {"beamDeform":37099.246094,"beamStrength":204409.562500},
