		["rh1l", "rsb1l"],
		["rh1r", "rsb1r"],
		["rsb1r", "rsb1l"],	

	{"highlight":{"radius":0.0, "col":"#ff37ffd9"}},		

        //subframe to body
        //{"highlight":{"radius":0.0075, "col":"#FFFF005f"}}
        //Primary Beams
        {"beamSpring":5393302.000000,"beamDamp":269.611176},

        ["rx2l", "a37"],
        ["rx2r", "a38"],
        ["rx2l", "a38"],
