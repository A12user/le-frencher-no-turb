{
"Camso_strut_R_52d28": {
    "information":{
        "authors":"BeamNG",
        "name":"No Turb MacPherson Strut Rear Suspension",
        "value":150
    },
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_R", "range", "", "Suspension", 1, 0.995, 1.005, "Rear Toe Adjust", "Adjusts the wheel toe-in angle",{"subCategory":"Alignment"}],
		["$RideHeightOffsetRear", "range", "+m", "Suspension", 0, -0.5, 0.5, "Rear Ride Height Offset", "Rear suspension ride height offset", {"stepDis":0.001,"subCategory":"Springs"}],
	    ["$trackOffset_R", "range", "+m", "Suspension", 0, -0.5, 0.5, "Rear Wheel Offset", "Spacing of rear wheels", {"stepDis":0.001,"subCategory":"Spacing"}],	
        ["$brakeOffset_R", "range", "+m", "Suspension", 0, -0.5, 0.5, "Rear Brake Offset", "Visual rear brake offset", {"stepDis":0.001,"subCategory":"Spacing"}],
        ["$hubStiffnessMult_R", "range", "", "Vehicle Advanced Settings", 1, 0.1, 3, "Rear Hub Stiffness", "Lower this value if wheels break off. Raise it if there is unwanted flex in the hubs", {"subCategory":"Wheel Hubs","stepDis":1,"minDis":10,"maxDis":300}]
    ],
    "slotType" : "Camso_suspension_R",
    "slots": [
        ["type", "default", "description"],
        //["wheels_rear","wheels_rear","Rear Wheels", {"nodeOffset":{"x":"$=$rearSuspensionOffsetX or 0", "y":"$=$rearSuspensionOffsetY or 0", "z":"$=$rearSuspensionOffsetZ or 0"}}],
        ["camso_hubs_rear_52d28","camso_hubs_rear_52d28","Rear Hubs"],
        ["Camso_suspensionmesh_R","Camso_suspensionmesh_R_52d28","Suspension Mesh", {"nodeOffset":{"x":"$=$rearSuspensionOffsetX or 0", "y":"$=$rearSuspensionOffsetY or 0", "z":"$=$rearSuspensionOffsetZ or 0"}}],
        ["Camso_brake_R","Camso_brake_R_52d28", "Rear Brakes", {"nodeOffset":{"x":"$=($rearSuspensionOffsetX or 0)+($brakeOffset_R or 0)", "y":"$=$rearSuspensionOffsetY or 0", "z":"$=$rearSuspensionOffsetZ or 0"}}],
        ["Camso_wheeldata_R_strut","Camso_wheeldata_R_strut_52d28", "Rear Spindles"{"coreSlot":true}],
        ["Camso_coilover_R_strut","Camso_coilover_R_strut_52d28", "Rear Coilovers"],
        ["Camso_swaybar_R_strut","Camso_swaybar_R_strut_52d28", "Rear Sway Bar"],
        ["Camso_differential_rear", "Camso_differential_rear_52d28", "Rear Differential"]
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"collision":true},
        {"selfCollision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"group":["hub_R", "susp_R"]},
        //rear hub
        {"nodeWeight":6.546926},
        //strut rail bottom point
        ["rh1r", -0.562392, 0.000000, -0.115244],
        ["rh1l",  0.562392, 0.000000, -0.115244],

        {"nodeWeight":4.000899},
        //strut body slidenode
        ["rh2r", -0.497855, 0.000000, 0.115244],
        ["rh2l",  0.497855, 0.000000, 0.115244],

        {"nodeWeight":3.273463},
        //hub mounting points for lower wishbone
        ["rh3r", -0.580831, -0.092195, -0.115244],
        ["rh3l",  0.580831, -0.092195, -0.115244],
        ["rh4r", -0.580831,  0.092195, -0.115244],
        ["rh4l",  0.580831,  0.092195, -0.115244],

        //brake caliper
        //{"nodeWeight":4.364617},
        ["rh5r", -0.580831, 0.138293, 0.000000],
        ["rh5l",  0.580831, 0.138293, 0.000000],
		//swaybar bushes (these should be approx same width and height as lower ball joint, 150mm behind)		
		
		["rsb1r", -0.580831,  0.230489, -0.115244], 
        ["rsb1l",  0.580831,  0.230489, -0.115244],

        {"selfCollision":false},
        {"nodeWeight":8.627558},
        {"group":["subframe_R","susp_R"]},
        {"chemEnergy":1917.821289,"burnRate":0.740277,"flashPoint":"$=($ignitionTemperatureMod or 1)*516.435730",
            "specHeat":0.8,"smokePoint":"$=($ignitionTemperatureMod or 1)*312.326813",/*"selfIgnitionCoef":"$=($ignitionChanceMod or 1)*0.141782"*/},
        ["rx1r", -0.267367, -0.184391, -0.092195],
        ["rx1l",  0.267367, -0.184391, -0.092195],
        ["rx2r", -0.267367,  0.184391, -0.092195],
        ["rx2l",  0.267367,  0.184391, -0.092195],

        //strut rail top point
        ["rs1r", -0.424099, 0.000000, 0.387221],
        ["rs1l",  0.424099, 0.000000, 0.387221],

        {"nodeWeight":9.706002},
        {"group":""},
        ["rco1r", -0.543953, 0.000000, 0.322684],
        ["rco1l",  0.543953, 0.000000, 0.322684],
        {"chemEnergy":false,"burnRate":false,"flashPoint":false,"specHeat":false,"smokePoint":false,"selfIgnitionCoef":false},
        {"group":""}
    ],
    "rails": {
        //rails form a line between 2 nodes that slidenodes will slide on. Used for any kind of telescoping motion such as steering racks, hydraulic rams, strut shafts.
        //strut shaft rail
        "strut_RR":{
            "links:":["rh1r", "rs1r"], "broken:":[], "looped":false, "capped":true
        },
        "strut_RL":{
            "links:":["rh1l", "rs1l"], "broken:":[], "looped":false, "capped":true
        }
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        //attach strut body to strut shaft rail
