	//debug outputs
	
	// "Tyre Aspect Coef"[ReartireAspectRatioDebug not found]

    "pressureWheels": [
    ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
    //these things enable new features that have been added since the introduction of the pressurewheel
    {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
    {"hasTire":true},
    {"enableTireReinfBeams":false},
    {"enableTireLbeams":true},
    {"enableTireSideReinfBeams":false},
    {"enableTreadReinfBeams":true},
    {"enableTirePeripheryReinfBeams":true},
    {"triangleCollision":false},

    //general settings
    {"radius":0.305000}, //Radius of the tire nodes
    {"hubRadius":0.203200}, //Radius of the rim
    {"wheelOffset":0}, //Offset from the original axle position (Left/right)
    {"hubWidth":0.170000}, //Width of the rim
    {"tireWidth":0.170000}, //Width of the tire
    {"numRays":16.000000}, //The amount of nodes to make the circle, more may result in smoother driving, but at the cost of performance, weight & stability

    //hub options
    {"hubTreadBeamSpring":"$=556372.875000 * ($rimStiffnessMult_R or 1)", "hubTreadBeamDamp":"$=26.616579 * ($rimStiffnessMult_R or 1)"},
    {"hubPeripheryBeamSpring":"$=819656.437500 * ($rimStiffnessMult_R or 1)", "hubPeripheryBeamDamp":"$=32.306149 * ($rimStiffnessMult_R or 1)"},
    {"hubSideBeamSpring":"$=656700.687500 * ($rimStiffnessMult_R or 1)", "hubSideBeamDamp":"$=18.327255 * ($rimStiffnessMult_R or 1)"},
    {"hubNodeWeight":0.509329},
    {"hubNodeMaterial":"|NM_METAL"},
    {"hubFrictionCoef":0.5},

    //tire options
    //sidebeams need to be high in expansion to control rolling resistance and tire expansion, but low in compression to allow air pressure to hold the weight
    {"wheelSideBeamSpringExpansion":"$=480631.187500 * ($tireStiffnessMult_R or 1)","wheelSideBeamDampExpansion":"$=30.657045 * ($tireStiffnessMult_R or 1)"},
    {"wheelSideBeamSpring":"$=0.000000 * ($tireStiffnessMult_R or 1) * $rearPSI","wheelSideBeamDamp":"$=30.657045 * ($tireStiffnessMult_R or 1)"},
    {"wheelSideTransitionZone":0.110490,"wheelSideBeamPrecompression":0.980000},

    //tread beams mainly control lateral stiffness of the tire, the higher the more responsive the handling
    {"wheelTreadBeamSpring":"$=136609.343750 * ($tireStiffnessMult_R or 1)","wheelTreadBeamDamp":"$=49.032696 * ($tireStiffnessMult_R or 1)"},
    {"wheelTreadBeamPrecompression":0.990000},
    {"wheelTreadBeamDampCutoffHz":500.000000},

    {"wheelTreadReinfBeamSpring":"$=111108.929688 * ($tireStiffnessMult_R or 1)","wheelTreadReinfBeamDamp":"$=66.330200 * ($tireStiffnessMult_R or 1)"},
    {"wheelTreadReinfBeamPrecompression":0.990000},
    {"wheelTreadReinfBeamDampCutoffHz":500.000000},

    //periphery beams mainly control longitudinal stiffness of the tire, the higher the values, the higher the peak grip, but can have more abrupt loss of traction
    {"wheelPeripheryBeamSpring":"$=65833.679688 * ($tireStiffnessMult_R or 1)","wheelPeripheryBeamDamp":"$=51.057659 * ($tireStiffnessMult_R or 1)"},
    {"wheelPeripheryBeamPrecompression":0.990000},
    {"wheelPeripheryBeamDampCutoffHz":500.000000},

    {"wheelPeripheryReinfBeamSpring":"$=61444.769531 * ($tireStiffnessMult_R or 1)","wheelPeripheryReinfBeamDamp":"$=49.326385 * ($tireStiffnessMult_R or 1)"},
    {"wheelPeripheryReinfBeamPrecompression":0.990000},
    {"wheelPeripheryReinfBeamDampCutoffHz":500.000000},

    //adds lateral stiffness to the tire structure, replicating stiff sidewalls
    {"wheelReinfBeamSpring":"$=12003.256836 * ($tireStiffnessMult_R or 1)","wheelReinfBeamDamp":"$=155.032883 * ($tireStiffnessMult_R or 1)"},
    {"wheelReinfBeamPrecompression":0.990000},
    {"wheelReinfBeamDampCutoffHz":500.000000},


    //general tire values
    {"nodeWeight":0.195546},
    {"nodeMaterial":"|NM_RUBBER"}, //Material just changes sound, skid marks, particles
    {"pressurePSI":"$rearPSI"}, //Tire pressure
    {"dragCoef":1}, //Air drag

    //groundmodel friction multipliers
    {"frictionCoef":1.000000}, //Multiplies the groundmodels maximum friction coefficient
    {"slidingFrictionCoef":"$=1.020000 *1.05"}, //Multiplies the groundmodels minimum friction coefficient
    {"treadCoef":0.500000}, //How much grip loss on rough groundmodels. Max value of 1 for the best off road tires
    {"stribeckExponent":2.160000},
    {"stribeckVelMult":2.050000},

    //advanced friction values
    {"noLoadCoef":1.081363}, //The friction coefficient with no normal force on the tire (highest possible coef)
    {"loadSensitivitySlope":"$=0.000182*0.9"}, //Determines the rate that friction coef drops off as normal force is added. Acts per node, in coef/Newton of normal force
    {"fullLoadCoef":0.095714}, //Minimum friction coef. Adding more normal force will not decrease the friction any more than this
    {"softnessCoef":0.600000}, //Influences the time variant friction behavior. Max value of 1 makes the tire more like soft racing slick rubber

    //deform values
    {"hubBeamDeform":65234.101562, "hubBeamStrength":73916.335938},

    {"wheelSideBeamDeform":23465.503906,"wheelSideBeamStrength":29331.878906},
    {"wheelReinfBeamDeform":117327.515625,"wheelReinfBeamStrength":117327.515625},
    {"wheelTreadBeamDeform":11732.751953,"wheelTreadBeamStrength":15252.577148},
    {"wheelTreadReinfBeamDeform":11732.751953,"wheelTreadReinfBeamStrength":15252.577148},
    {"wheelPeripheryBeamDeform":58663.757812,"wheelPeripheryBeamStrength":58663.757812},

    //cancel out brake properties before future wheel parts are loaded
    {"brakeTorque":0},
    {"parkingTorque":0},
    {"enableBrakeThermals":false},
    {"brakeDiameter":false},
    {"brakeMass":false},
    {"brakeType":false},
