        {"beamSpring":6198146.500000,"beamDamp":1458.215820},
        //{"beamDeform":53978.613281,"beamStrength":337145.125000},
        //precompression creates slight alignment tweak for 0 camber at base ride height
        {"beamPrecompression":"$CamberFront"},
