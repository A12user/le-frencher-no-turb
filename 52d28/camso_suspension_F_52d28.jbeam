{
"Camso_doublewishbone_F_52d28": {
    "information":{
        "authors":"BeamNG",
        "name":"No Turb Double Wishbone Front Suspension",
        "value":150
    },
	
		//debug outputs
	
	// "ride height" 30.299999
	//"suspension travel" 0.103966
	//"WeightDist" 1.000000
	//"TrackWidth" 1.400000
	//"RackPosition" [RackPosition not found]
	

	
	
	
    "variables": [
		["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
		["$RideHeightOffsetFront", "range", "+m", "Suspension", 0, -0.5, 0.5, "Front Ride Height Offset", "Front suspension ride height offset", {"stepDis":0.001,"subCategory":"Springs"}],
        ["$CamberFront", "range", "", "Suspension", 0.996, 0.9, 1.092, "Front Camber", "Front wheel camber", {"stepDis":0.001,"subCategory":"Alignment","minDis":90,"maxDis":109.2}],
	    ["$trackOffset_F", "range", "+m", "Suspension", 0, -0.5, 0.5, "Front Wheel Offset", "Spacing of rear wheels", {"stepDis":0.001,"subCategory":"Spacing"}],
        ["$brakeOffset_F", "range", "+m", "Suspension", 0, -0.5, 0.5, "Front Brake Offset", "Visual front brake offset", {"stepDis":0.001,"subCategory":"Spacing"}],
        ["$hubStiffnessMult_F", "range", "", "Vehicle Advanced Settings", 1, 0.1, 3, "Front Hub Stiffness", "Lower this value if wheels break off. Raise it if there is unwanted flex in the hubs", {"subCategory":"Wheel Hubs","stepDis":1,"minDis":10,"maxDis":300}],
        ["$SuspensionSubframeStiffnessMult_F", "range", "", "Vehicle Advanced Settings", 1, 0.1, 3, "Front Subframe Stiffness", "Lower this value if the front of the car is vibrating.", {"subCategory":"Suspension","stepDis":1,"minDis":10,"maxDis":200}]
    ],
    "slotType" : "Camso_suspension_F",
    "slots": [
        ["type", "default", "description"]
        //["wheels_front","wheels_front","Front Wheels", {"nodeOffset":{"x":"$frontSuspensionOffsetX", "y":"$frontSuspensionOffsetY", "z":"$frontSuspensionOffsetZ"}}],
        ["camso_hubs_front_52d28","camso_hubs_front_52d28","Front Hubs"],
        ["Camso_suspensionmesh_F","Camso_suspensionmesh_F_52d28","Suspension Mesh", {"nodeOffset": {"x":"$=$frontSuspensionOffsetX or 0", "y":"$=$frontSuspensionOffsetY or 0", "z":"$=$frontSuspensionOffsetZ or 0"}}],
        ["Camso_brake_F","Camso_brake_F_52d28", "Front Brakes", {"nodeOffset": {"x":"$=($frontSuspensionOffsetX or 0)+($brakeOffset_F or 0)", "y":"$=$frontSuspensionOffsetY or 0", "z":"$=$frontSuspensionOffsetZ or 0"}}],
        ["Camso_wheeldata_F_doublewishbone","Camso_wheeldata_F_doublewishbone_52d28", "Front Spindles", {"coreSlot":true}],
        ["Camso_coilover_F_doublewishbone","Camso_coilover_F_doublewishbone_52d28", "Front Coilovers"],
        ["Camso_swaybar_F_doublewishbone","Camso_swaybar_F_doublewishbone_52d28", "Front Sway Bar"],
        ["Camso_steering_doublewishbone","Camso_steering_doublewishbone_52d28", "Steering", ],
        ["Camso_differential_front", "Camso_differential_front_52d28", "Front Differential"]
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"collision":true},
        {"selfCollision":true},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},

        {"nodeWeight":6.636715},
        //hub mounting points for lower wishbone
        {"group":["hub_F","susp_F"]},
        ["fh1r", -0.570603, -0.013564, "$=-0.107573 + (0.009354*0.000000)"], //raising this will lower roll center a LOT
        ["fh1l",  0.570603, -0.013564, "$=-0.107573 + (0.009354*0.000000)"],
		
		 

        {"nodeWeight":3.982029},
        //hub mounting points for upper wishbone
        ["fh2r", -0.514478, 0.012254, "$=0.116927 + (-0.000000*0.000000)"],
        ["fh2l",  0.514478, 0.012254, "$=0.116927 + (-0.000000*0.000000)"],
		
		

        //tie rod ends
        ["fh3r", -0.570603, 0.149666, "$=-0.107573 + (0.009354*0.000000)"], //must be at same X and Z as lower balljoint, note that Y isn't scaling with NS to keep steering arm length.
        ["fh3l",  0.570603,0.149666, "$=-0.107573 + (0.009354*0.000000)"],

        //brake caliper
        //{"nodeWeight":5.309372},
        ["fh5r", -0.589311, -0.140312, 0.000000],
        ["fh5l",  0.589311, -0.140312, 0.000000],

        //subframe
        {"selfCollision":true},
        {"nodeWeight":5.321671},
        {"chemEnergy":1917.821289,"burnRate":0.740277,"flashPoint":"$=($ignitionTemperatureMod or 1)*516.435730",
            "specHeat":0.8,"smokePoint":"$=($ignitionTemperatureMod or 1)*312.326813",/*"selfIgnitionCoef":"$=($ignitionChanceMod or 1)*0.141782"*/},
			
			
			
        //body mounting points for lower wishbone
        {"group":["subframe_F", "susp_F"]},
        ["fx1r", "$=-0.243208 + (0.000000*0.000000)", -0.187083, "$=-0.128152 + (0.056125*0.000000)"], //raising this will raise roll center 
        ["fx1l",  "$=0.243208 + (-0.000000*0.000000)", -0.187083, "$=-0.128152 + (0.056125*0.000000)"],
        ["fx2r", "$=-0.243208 + (0.000000*0.000000)",  0.187083, "$=-0.128152 + (0.056125*0.000000)"],
        ["fx2l",  "$=0.243208 + (-0.000000*0.000000)",  0.187083, "$=-0.128152 + (0.056125*0.000000)"],
		
				//Swaybar bushes
		
		["fsb1r", "$=-0.514478",  "$=0.256304", "$=0.116927"], 
        ["fsb1l",  "$=0.514478",  "$=0.256304", "$=0.116927"],	  
		
		
		

        //body mounting points for upper wishbone
        {"group":["subframe_F", "susp_F"]},
        ["fx3r", "$=-0.327395 + (0.000000*0.000000)", -0.187083, "$=0.130958 + (0.018708*0.000000)"], //raising this will lower roll center 
        ["fx3l",  "$=0.327395 + (-0.000000*0.000000)", -0.187083, "$=0.130958 + (0.018708*0.000000)"],
        ["fx4r","$=-0.327395 + (0.000000*0.000000)",  0.187083, "$=0.056125 + (0.018708*0.000000)"],
        ["fx4l",  "$=0.327395 + (-0.000000*0.000000)",  0.187083, "$=0.056125 + (0.018708*0.000000)"],

        {"nodeWeight":5.986880},
        //body mounting points for spring and shock
        {"group":["subframe_F", "susp_F"]},
        ["fs1r", -0.561249, 0.000000, 0.285301],
        ["fs1l",  0.561249, 0.000000, 0.285301],
        {"chemEnergy":false,"burnRate":false,"flashPoint":false,"specHeat":false,"smokePoint":false,"selfIgnitionCoef":false},
        {"group":""}
    ],

    "beams": [
        ["id1:", "id2:"],
        //double wishbone suspension
        {"beamPrecompression":1, "beamType":"|NORMAL"},
        //hub
		{"highlight":{"radius":0.0075, "col":"#ff0137d9"}},
        {"beamSpring":"$=6372131.000000*($hubStiffnessMult_F or 1)","beamDamp":"$=159.281158*($hubStiffnessMult_F or 1)"},
