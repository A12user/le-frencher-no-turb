"Camso_steering_doublewishbone_52d28": {
    "information":{
        "authors":"BeamNG",
        "name":"No Turb Rack and Pinion Steering",
        "value":110
    },
    "slotType" : "Camso_steering_doublewishbone",
    "slots": [
        ["type", "default", "description"],
        ["Camso_power_steering", "Camso_power_steering", "Power Steering"]
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_F", "range", "", "Suspension", 1, 0.995, 1.005, "Front Toe Adjust", "Adjusts the wheel toe-in angle",{"subCategory":"Alignment"}],
        ["$ffbTune", "range", "", "Force Feedback", 1, 0, 2, "Strength Multiplier", "Fine tune the force feedback strength for this vehicle", {"minDis":0,"maxDis":200}],
   		["$maxSteeringMult", "range", "", "Suspension", 1, 0.5, 1.5, "Maximum steering angle multiplier", "Adjusts the max steering angle", {"subCategory":"Alignment","minDis":50,"maxDis":150,"stepDis":0.01}]
        ["$steer_center_F", "range", "", "Suspension", 0, -0.002, 0.002, "Steering L/R Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Alignment"}]
        ["$steeringWheelLock", "range", "Deg", "Suspension", 450.000000, 225, 900, "Steering Wheel Lock", "Adjusts the steering ratio",{"subCategory":"Alignment","minDis":225,"maxDis":900,"stepDis":5}],
    ],
    //steering rack rail
    //rails form a line between 2 nodes that slidenodes will slide on. Used for any kind of telescoping motion such as steering racks, hydraulic rams, strut shafts.
    "rails": {
        "steeringrack":{"links:":["st2r", "st2l"], "broken:":[], "looped":false, "capped":true,}
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
        //the steering rack slides on these nodes
        ["st1r", "steeringrack", true, true, 0.0, 6652754.000000, "FLT_MAX", "FLT_MAX"],
        ["st1l", "steeringrack", true, true, 0.0, 6652754.000000, "FLT_MAX", "FLT_MAX"]
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"selfCollision":false},
        {"collision":false},
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        {"nodeWeight":2.993440},
        //steering rack ends
        ["st2r", "$=-0.243208", "$=0.131893 + 0.064615", "$=-0.135635 + (0.056125*0.000000)"], //same XZ as inner lower wishbone mount FX2r, more+ Y = more ackerman
        ["st2l",  "$=0.243208", "$=0.131893 + 0.064615", "$=-0.135635 + (0.056125*0.000000)"], //note that Y isn't scaling with ns
        //body mounting points for steering rack
        {"nodeWeight":5.321671},
        ["st1r", -0.093541, "$=0.131893  + 0.064615", "$=-0.135635 + (0.056125*0.000000)"],
        ["st1l",  0.093541, "$=0.131893  + 0.064615", "$=-0.135635 + (0.056125*0.000000)"], //note that Y isn't scaling with ns
        {"group":""}
    ],
    "beams": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":2328896.250000,"beamDamp":66.520889},
        {"beamDeform":52884.105469,"beamStrength":117409.367188},
        //steering rack mounting to body
        ["st1l", "st1r"],
        ["fx1l", "st1l"],
        ["fx2l", "st1l"],
        ["fx1r", "st1r"],
        ["fx2r", "st1r"],
        ["st1l", "fx2r"],
        ["st1r", "fx2l"],
        ["fx1l", "st1r"],
        ["fx1r", "st1l"],
        ["fx4l", "st1l"],
        ["fx4r", "st1r"],
        ["fx4r", "st1l"],
        ["fx4l", "st1r"],

        //Vertical Rack Supports
        ["st1r", "a54"],
        ["st1r", "a58"],
        ["st1l", "a53"],
        ["st1l", "a57"],
		
		
		 	{"highlight":{"radius":0.00, "col":"#ff0137d9"}},

        //center link
		{"highlight":{"radius":0.0075, "col":"#ff0137d9"}},
        {"beamSpring":9978798.000000,"beamDamp":166.302216},
		["st2r","st2l"],
		{"highlight":{"radius":0.00, "col":"#ff0137d9"}},


        //tie rod ends
		{"highlight":{"radius":0.0075, "col":"#43ff64d9"}}
        {"beamSpring":7705249.500000,"beamDamp":166.302216},
        {"beamDeform":39579.929688,"beamStrength":183930.250000},
        //preCompression for slight toe in tweak
        ["fh3r","st2r",{"beamPrecompression":"$=(0.005000 * 1.120490)/110+(0.94*(1.063138))*$toe_F-$steer_center_F"}],
        ["fh3l","st2l",{"beamPrecompression":"$=(0.005000 * 1.120490)/110+(0.94*(1.063138))*$toe_F+$steer_center_F"}],
		{"highlight":{"radius":0.00, "col":"#43ff64d9"}}

        //steering limit
        //extreme limits for steering, to prevent inversion when hitting bumps or crashing at full lock
        //if increasing steering lock, change Precompression values to avoid binding
        {"beamPrecompression":1, "beamType":"|SUPPORT", "beamLongBound":4},
        {"beamSpring":3326709.500000,"beamDamp":166.302216,"beamDeform":79825.062500,"beamStrength":106433.421875},
        {"beamPrecompression":0.73},
        ["fh3r","fx1r"],
        ["fh3l","fx1l"],
        {"beamPrecompression":0.85},
        ["fh5r","fx2r"],
        ["fh5l","fx2l"],
        {"beamPrecompression":1},

        //steering damper
        //doesnt interfere at normal steering speeds but dampens violent shakes
        {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamDeform":6652.088867,"beamStrength":6652.088867},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        {"beamSpring":0,"beamDamp":0},
        ["fh3r","fx1r",{"beamDampVelocitySplit":0.05,"beamDampFast":665.208862,"beamDampReboundFast":665.208862,"beamDamp":0,"beamDampRebound":0,"dampCutoffHz":1000}],
        ["fh3l","fx1l",{"beamDampVelocitySplit":0.05,"beamDampFast":665.208862,"beamDampReboundFast":665.208862,"beamDamp":0,"beamDampRebound":0,"dampCutoffHz":1000}],
        ["fh5r","fx2r",{"beamDampVelocitySplit":0.05,"beamDampFast":665.208862,"beamDampReboundFast":665.208862,"beamDamp":0,"beamDampRebound":0,"dampCutoffHz":1000}],
        ["fh5l","fx2l",{"beamDampVelocitySplit":0.05,"beamDampFast":665.208862,"beamDampReboundFast":665.208862,"beamDamp":0,"beamDampRebound":0,"dampCutoffHz":1000}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":false,"beamDamp":false},
		{"beamLimitSpring":false,"beamLimitDamp":false}
    ],
    "hydros": [
        ["id1:","id2:"],
        {"beamPrecompression":1.0, "beamType":"| BOUNDED", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":5654940.500000,"beamDamp":0,"beamDeform":"FLT_MAX","beamStrength":183930.250000},
        //hydros are beams which can change their target length over time, in this case connected to the steering input
        //factor controls the amount of travel as a ratio of the steering rack length
        //steeringWheelLock controls the steering wheel visual rotation and speed of steering assists
        //["st2l","st1r",{"factor":"$=0.000000/((0.000000+$frontSuspensionOffsetX*2)/0.000000)*$maxSteeringMult", "steeringWheelLock":450, "inRate":1.25,"outRate":1.25}],
        //["st2r","st1l",{"factor":"$=-0.000000/((0.000000+$frontSuspensionOffsetX*2)/0.000000)*$maxSteeringMult","steeringWheelLock":450, "inRate":1.25,"outRate":1.25}],
        ["st2l","st1r",{"factor":"$=0.14 * 1.650000 * 0.928120 * (0.760000)  *$maxSteeringMult", "steeringWheelLock":"$steeringWheelLock", "inRate":1.25,"outRate":1.25}],
        ["st2r","st1l",{"factor":"$=-0.14 * 1.650000 * 0.928120 * (0.760000)*$maxSteeringMult","steeringWheelLock":"$steeringWheelLock", "inRate":1.25,"outRate":1.25}],
        {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1}
    ],
    "input": {
        //modifier for force feedback to account for differences in vehicles
        "FFBcoef":"$=13*1.500000*$ffbTune"
    }
}
}
