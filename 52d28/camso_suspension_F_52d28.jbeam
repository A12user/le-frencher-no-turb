        //{"beamDeform":53978.613281,"beamStrength":337145.125000},
        //breakGroup: when one beam breaks, all beams in the group are forced to break
		{"highlight":{"radius":0.0075, "col":"#ff2264d9"}},
        {"breakGroup":"wheel_FR"},
