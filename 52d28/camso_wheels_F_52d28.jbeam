        ["$rimStiffnessMult_F", "range", "", "Vehicle Advanced Settings", 1, 0.1, 3, "Front Rim Stiffness", "Lower this value if rims become unstable at speed. Raise it if there is unwanted flex in the wheels", {"subCategory":"Wheels","stepDis":1,"minDis":10,"maxDis":300}],
        ["$tireStiffnessMult_F", "range", "", "Vehicle Advanced Settings", 1, 0.1, 3, "Front Tire Stiffness", "Lower this value if tires become unstable at speed. Raise it if there is unwanted flex in the tires", {"subCategory":"Wheels","stepDis":1,"minDis":10,"maxDis":300}]
    ],
	
	//debug outputs
	
	// "Tyre Aspect Coef"[FronttireAspectRatioDebug not found]
	
    "pressureWheels": [
    ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
    //these things enable new features that have been added since the introduction of the pressurewheel
    {"disableMeshBreaking":false,"disableHubMeshBreaking":false},
    {"hasTire":true},
    {"enableTireReinfBeams":false},
    {"enableTireLbeams":true},
    {"enableTireSideReinfBeams":false},
    {"enableTreadReinfBeams":true},
    {"enableTirePeripheryReinfBeams":true},
    {"triangleCollision":false},

    //general settings
    {"radius":0.305000}, //Radius of the tire nodes
    {"hubRadius":0.203200}, //Radius of the rim
    {"wheelOffset":0}, //Offset from the original axle position (Left/right)
    {"hubWidth":0.175000}, //Width of the rim
    {"tireWidth":0.175000}, //Width of the tire
    {"numRays":16.000000}, //The amount of nodes to make the circle, more may result in smoother driving, but at the cost of performance, weight & stability

    //hub options
    {"hubTreadBeamSpring":"$=662263.687500 * ($rimStiffnessMult_F or 1)", "hubTreadBeamDamp":"$=31.719471 * ($rimStiffnessMult_F or 1)"},
    {"hubPeripheryBeamSpring":"$=978297.687500 * ($rimStiffnessMult_F or 1)", "hubPeripheryBeamDamp":"$=38.551918 * ($rimStiffnessMult_F or 1)"},
    {"hubSideBeamSpring":"$=802567.187500 * ($rimStiffnessMult_F or 1)", "hubSideBeamDamp":"$=22.346161 * ($rimStiffnessMult_F or 1)"},
    {"hubNodeWeight":0.607688},
    {"hubNodeMaterial":"|NM_METAL"},
    {"hubFrictionCoef":0.5},

    //tire options
    //sidebeams need to be high in expansion to control rolling resistance and tire expansion, but low in compression to allow air pressure to hold the weight
    {"wheelSideBeamSpringExpansion":"$=488894.812500 * ($tireStiffnessMult_F or 1)","wheelSideBeamDampExpansion":"$=31.184141 * ($tireStiffnessMult_F or 1)"},
    {"wheelSideBeamSpring":"$=0.000000 * ($tireStiffnessMult_F or 1) * $frontPSI","wheelSideBeamDamp":"$=31.184141 * ($tireStiffnessMult_F or 1)"},
    {"wheelSideTransitionZone":0.111779,"wheelSideBeamPrecompression":0.980000},

    //tread beams mainly control lateral stiffness of the tire, the higher the more responsive the handling
    {"wheelTreadBeamSpring":"$=139433.062500 * ($tireStiffnessMult_F or 1)","wheelTreadBeamDamp":"$=49.960896 * ($tireStiffnessMult_F or 1)"},
    {"wheelTreadBeamPrecompression":0.990000},
    {"wheelTreadBeamDampCutoffHz":500.000000},

    {"wheelTreadReinfBeamSpring":"$=113405.562500 * ($tireStiffnessMult_F or 1)","wheelTreadReinfBeamDamp":"$=67.585846 * ($tireStiffnessMult_F or 1)"},
    {"wheelTreadReinfBeamPrecompression":0.990000},
    {"wheelTreadReinfBeamDampCutoffHz":500.000000},

    //periphery beams mainly control longitudinal stiffness of the tire, the higher the values, the higher the peak grip, but can have more abrupt loss of traction
    {"wheelPeripheryBeamSpring":"$=67108.570312 * ($tireStiffnessMult_F or 1)","wheelPeripheryBeamDamp":"$=51.990929 * ($tireStiffnessMult_F or 1)"},
    {"wheelPeripheryBeamPrecompression":0.990000},
    {"wheelPeripheryBeamDampCutoffHz":500.000000},

    {"wheelPeripheryReinfBeamSpring":"$=62634.667969 * ($tireStiffnessMult_F or 1)","wheelPeripheryReinfBeamDamp":"$=50.228008 * ($tireStiffnessMult_F or 1)"},
    {"wheelPeripheryReinfBeamPrecompression":0.990000},
    {"wheelPeripheryReinfBeamDampCutoffHz":500.000000},

    //adds lateral stiffness to the tire structure, replicating stiff sidewalls
    {"wheelReinfBeamSpring":"$=12352.027344 * ($tireStiffnessMult_F or 1)","wheelReinfBeamDamp":"$=158.615326 * ($tireStiffnessMult_F or 1)"},
    {"wheelReinfBeamPrecompression":0.990000},
    {"wheelReinfBeamDampCutoffHz":500.000000},


    //general tire values
    {"nodeWeight":0.198908},
    {"nodeMaterial":"|NM_RUBBER"}, //Material just changes sound, skid marks, particles
    {"pressurePSI":"$frontPSI"}, //Tire pressure
    {"dragCoef":1}, //Air drag

    //groundmodel friction multipliers
    {"frictionCoef":1.000000}, //Multiplies the groundmodels maximum friction coefficient
    {"slidingFrictionCoef":"$=1.020000 *0.98"}, //Multiplies the groundmodels minimum friction coefficient
    {"treadCoef":0.500000}, //How much grip loss on rough groundmodels. Max value of 1 for the best off road tires
    {"stribeckExponent":2.160000},
    {"stribeckVelMult":2.050000},

    //advanced friction values
    {"noLoadCoef":1.081363}, //The friction coefficient with no normal force on the tire (highest possible coef)
    {"loadSensitivitySlope":"$=0.000178 * 1"}, //Determines the rate that friction coef drops off as normal force is added. Acts per node, in coef/Newton of normal force
    {"fullLoadCoef":0.095714}, //Minimum friction coef. Adding more normal force will not decrease the friction any more than this
    {"softnessCoef":0.600000}, //Influences the time variant friction behavior. Max value of 1 makes the tire more like soft racing slick rubber

    //deform values
    {"hubBeamDeform":66355.687500, "hubBeamStrength":75187.203125},

    {"wheelSideBeamDeform":23868.953125,"wheelSideBeamStrength":29836.191406},
    {"wheelReinfBeamDeform":119344.765625,"wheelReinfBeamStrength":119344.765625},
    {"wheelTreadBeamDeform":11934.476562,"wheelTreadBeamStrength":15514.819336},
    {"wheelTreadReinfBeamDeform":11934.476562,"wheelTreadReinfBeamStrength":15514.819336},
    {"wheelPeripheryBeamDeform":59672.382812,"wheelPeripheryBeamStrength":59672.382812},

    //cancel out brake properties before future wheel parts are loaded
    {"brakeTorque":0},
    {"parkingTorque":0},
    {"enableBrakeThermals":false},
    {"brakeDiameter":false},
    {"brakeMass":false},
    {"brakeType":false},
    {"rotorMaterial":false},
    {"brakeVentingCoef":false}
    ]
}, 
